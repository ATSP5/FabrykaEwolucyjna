    {
      "nodeData": {
        "codeText": "",
        "codeFile": "block_code/FactoryDashboard.py",
        "maxInputNumber": 5,
        "maxOutputNumber": 10,
        "documentationText": "",
        "documentationFile": "FactoryDashboard.md",
        "nodeCathegory": 29,
        "id": 100,
        "settings": {
          "objectifable": false,
          "canBeMain": false,
